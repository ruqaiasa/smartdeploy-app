# --------------------------
# Backend - Spring Boot
# --------------------------
backend/target/
backend/.idea/
backend/*.iml

backend/.env
backend/.env.*
!backend/.env.example

backend/*.log
backend/logs/

# --------------------------
# Frontend - Vue / Vite
# --------------------------
frontend/node_modules/
frontend/dist/

frontend/.env
frontend/.env.*
!frontend/.env.example

frontend/.eslintcache
frontend/.vscode/

# --------------------------
# Global
# --------------------------
.idea/
.vscode/

*.log

.DS_Store
Thumbs.db

*.tmp
*.temp
*.swp
*~
